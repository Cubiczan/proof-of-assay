{
  "version": "0.1",
  "type": "container",
  "ops": [
    {
      "id": "proof-of-assay-llm",
      "type": "container/run",
      "args": {
        "gpu": true,
        "image": "docker.io/ollama/ollama:0.32.6",
        "env": {
          "MODEL": "qwen2.5:7b"
        },
        "entrypoint": ["/bin/sh"],
        "cmd": [
          "-c",
          "ollama serve & pid=$!; i=0; until ollama list >/dev/null 2>&1 || [ \"$i\" -ge 60 ]; do i=$((i+1)); sleep 1; done; ollama pull \"$MODEL\"; wait $pid"
        ],
        "expose": [
          {
            "port": 11434,
            "health_checks": [
              {
                "type": "http",
                "path": "/api/tags",
                "method": "GET",
                "expected_status": 200,
                "continuous": false
              }
            ]
          }
        ]
      }
    }
  ],
  "meta": {
    "trigger": "dashboard",
    "system_requirements": {
      "vram_total_mb": 8192
    }
  }
}
